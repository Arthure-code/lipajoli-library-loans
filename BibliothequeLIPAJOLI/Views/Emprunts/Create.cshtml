@model BibliothequeLIPAJOLI.DTOs.EmpruntDto

<h2>Créer un emprunt</h2>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group mb-3">
        <label asp-for="Usager.No">Numéro d'usager</label>
        <input asp-for="Usager.No" class="form-control" type="number" />
        <span asp-validation-for="Usager.No" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Livre.CodeUnique">Code du livre</label>
        <input asp-for="Livre.CodeUnique" class="form-control" />
        <span asp-validation-for="Livre.CodeUnique" class="text-danger"></span>
    </div>

    <input type="hidden" asp-for="DateEmprunt" />
    <input type="hidden" asp-for="DateRetourLimite" />
    <input type="hidden" asp-for="DateRetour" />
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="UsagerID" />
    <input type="hidden" asp-for="LivreID" />

    <button type="submit" class="btn btn-primary">Créer</button>
    <a asp-action="Index" class="btn btn-secondary ms-2">Annuler</a>
</form>