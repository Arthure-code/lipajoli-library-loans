@model BibliothequeLIPAJOLI.DTOs.EmpruntDto

@{
    ViewData["Title"] = "Retourner un emprunt";
}

<h2 class="mb-4">Retourner un emprunt</h2>

@if (TempData["Message"] != null)
{
    <div class="alert alert-info">@TempData["Message"]</div>
}

<div class="row">
    <div class="col-md-6">
        <dl class="row">
            <dt class="col-sm-4">Usager</dt>
            <dd class="col-sm-8">@Model.Usager?.Prenom @Model.Usager?.Nom</dd>

            <dt class="col-sm-4">Livre</dt>
            <dd class="col-sm-8">@Model.Livre?.Titre</dd>

            <dt class="col-sm-4">Date d'emprunt</dt>
            <dd class="col-sm-8">@Model.DateEmprunt.ToShortDateString()</dd>

            <dt class="col-sm-4">Date limite</dt>
            <dd class="col-sm-8">@Model.DateRetourLimite.ToShortDateString()</dd>

            <dt class="col-sm-4">Date de retour</dt>
            <dd class="col-sm-8">
                @if (Model.DateRetour != null)
                {
                    <span class="text-success">@Model.DateRetour?.ToShortDateString()</span>
                }
                else
                {
                    <span class="text-warning">Non retourné</span>
                }
            </dd>
        </dl>

        @if (Model.DateRetour == null)
        {
            <form asp-action="Retourner" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="UsagerID" />
                <input type="hidden" asp-for="LivreID" />
                <input type="hidden" asp-for="DateEmprunt" />
                <input type="hidden" asp-for="DateRetourLimite" />
                <input type="hidden" asp-for="DateRetour" value="@DateTime.Now" />

                <button type="submit" class="btn btn-primary">Confirmer le retour</button>
                <a asp-action="Index" class="btn btn-secondary ms-2">Annuler</a>
            </form>
        }
        else
        {
            <div class="alert alert-success">Ce livre a déjà été retourné.</div>
            <a asp-action="Index" class="btn btn-secondary">Retour à la liste</a>
        }
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}