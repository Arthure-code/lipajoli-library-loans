@model BibliothequeLIPAJOLI.Models.Livre

@{
    ViewData["Title"] = "Livre - Modification";
}

<h1>Modification d'un livre</h1>

<h4>Livre</h4>

<form asp-action="Edit">

    <partial name="_Champs" model="Model" />

    <partial name="_Auteurs" model="Model" />
        <div class="form-group">
            <input type="submit" value="Sauvegarder" class="btn btn-primary" />
        </div>

    </form>

    <div>
        <a asp-action="Index">Retour à la liste de livres</a>
    </div>

    @section Scripts {
        @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    }
