@model BibliothequeLIPAJOLI.Models.Livre

@{
    ViewData["Title"] = "Livre - Suppression";
}

<h1>Suppression d'un livre</h1>

<h3>Voulez-vous vraiment supprimer cette entrée?</h3>
<div>
    <h4>Livre</h4>
    <hr />
    <p class="text-danger">@ViewData["MessageErreur"]</p>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.CodeUnique)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.CodeUnique)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Isbn10)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Isbn10)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Isbn13)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Isbn13)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Titre)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Titre)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Quantite)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Quantite)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Prix)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Prix)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Auteurs)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Auteurs)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Categorie)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Categorie)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="ID" />
        <input type="submit" value="Supprimer" class="btn btn-danger" /> |
        <a asp-action="Index">Retour à la liste de livres</a>
    </form>
</div>
