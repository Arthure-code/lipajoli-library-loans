@model BibliothequeLIPAJOLI.Models.Livre

@{
    ViewData["Title"] = "Livre - Suppression";
}

<h1>Suppression d'un livre</h1>

<h3>Voulez-vous vraiment supprimer cette entrée?</h3>
<div>
    <h4>Livre</h4>
    <hr />
    <p class="text-danger">@ViewData["MessageErreur"]</p>
    <partial name="_Fiche" model="Model" />
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="ID" />
        <input type="submit" value="Supprimer" class="btn btn-danger" /> |
        <a asp-action="Index">Retour à la liste de livres</a>
    </form>
</div>
