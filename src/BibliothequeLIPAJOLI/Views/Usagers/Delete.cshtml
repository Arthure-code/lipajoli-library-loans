@model BibliothequeLIPAJOLI.Models.Usager

@{
    ViewData["Title"] = "Usager - Suppression";
}

<h1>Suppression d'un usager</h1>

<h3>Voulez-vous vraiment supprimer cette entrée?</h3>
<div>
    <h4>Usager</h4>
    <hr />
    <p class="text-danger">@ViewData["MessageErreur"]</p>
    <partial name="_Fiche" model="Model" />

    <form asp-action="Delete">
        <input type="hidden" asp-for="ID" />
        <input type="submit" value="Supprimer" class="btn btn-danger" /> |
        <a asp-action="Index">Retour à la liste d'usagers</a>
    </form>
</div>
